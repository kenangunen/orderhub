<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- DEĞİŞTİ: parent artık kök pom; Boot parent'ı kök üzerinden miras alınıyor -->
    <parent>
        <groupId>com.orderhub</groupId>
        <artifactId>orderhub-root</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>   <!-- parent'ı bir üst klasörde ara -->
    </parent>

    <!-- groupId ve version parent'tan geliyor; sadece servisin kendi adı -->
    <artifactId>product-service</artifactId>
    <name>product-service</name>
    <description>OrderHub katalog servisi: ürün bilgisi, stok sorgusu</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring'in cache soyutlaması -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- Sağlayıcı; versiyonu Boot yönetiyor -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- DEĞİŞTİ: lombok silindi (kökten geliyor) -->
    </dependencies>

    <build>
        <plugins>
            <!-- DEĞİŞTİ: maven-compiler-plugin silindi (Lombok processor kökten geliyor) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>